# Copia este archivo a `.env` y pon ahí las llaves. `.env` está en .gitignore
# y no se sube nunca; este ejemplo sí se sube, así que aquí no va ningún valor.

# Escribe el contenido de los ejercicios. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Sólo para buscar el video de la estación 1. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opcionales: el valor de en medio es el que se usa si no dices nada.
# ANDAMIO_MODELO=claude-haiku-4-5
# ANDAMIO_MODELO_BUSQUEDA=gpt-4.1-mini
