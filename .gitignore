# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# Las llaves de API viven aqui y nunca se suben.
.env
.env.*
!.env.ejemplo
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Proyecto anterior, archivado para consulta
_viejo/

# Los ajustes locales de Claude Code, que pueden llevar llaves en su bloque env.
# `.claude/settings.json` no va aqui: ya esta versionado a proposito y solo lleva
# que plugins estan prendidos. Si alguna vez se le agrega un bloque `env`, las
# llaves van en `.env`, no ahi.
.claude/settings.local.json

# Estado de una corrida de tanda.mjs, no contenido: se regenera solo.
contenido/temas/_tanda-*.json
